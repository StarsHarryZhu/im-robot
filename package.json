{
  "name": "@starsharryzhu/im-robot",
  "version": "0.3.0",
  "description": "Connect a WeChat account to a DeepSeek Harness session: messages from the account that scanned the login code, with their images, files, voice, and video saved in a folder, are prompted into the bound session; the turn's final reply goes back as plain text, and a caller can send text, images, videos, and files at any time. Host-only, no tools, no prompts.",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "wechat",
    "weixin",
    "ilink",
    "im"
  ],
  "author": "Starfield (https://github.com/StarsHarryZhu)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/StarsHarryZhu/im-robot.git"
  },
  "homepage": "https://github.com/StarsHarryZhu/im-robot#readme",
  "bugs": {
    "url": "https://github.com/StarsHarryZhu/im-robot/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "cordis.patch.yml",
    "locale/*.json",
    "README.md",
    "AGENTS.md",
    "THIRD_PARTY_NOTICES.md",
    "LICENSE"
  ],
  "scripts": {
    "link-dev": "node scripts/link-dev.mjs",
    "build": "node build.js",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit -p tsconfig.json",
    "test": "node build.js && node node_modules/vitest/vitest.mjs run"
  },
  "dependencies": {},
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-credentials": ">=0.2.1-rc.5 <0.3.0-0",
    "@deepseek-ai/schemastery": "^3.18.5",
    "@types/node": "^22.20.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-credentials": ">=0.2.1-rc.5 <0.3.0-0",
    "@deepseek-ai/schemastery": "^3.18.5"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.1-rc.5 <0.3.0-0"
  },
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "license": "MIT"
}
